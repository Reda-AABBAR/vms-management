import { fileURLToPath, pathToFileURL } from 'node:url';
import { dirname, join } from 'node:path';
import { readFileSync, existsSync } from 'node:fs';
import express from 'express';

const __dirname = dirname(fileURLToPath(import.meta.url));
const DIST_FOLDER = join(__dirname, '../dist');
const BROWSER_FOLDER = join(DIST_FOLDER, 'browser');
const SERVER_FOLDER = join(DIST_FOLDER, 'server');
const INDEX_HTML = join(BROWSER_FOLDER, 'index.html');

// Angular 20 SSR bundle file
const SERVER_BUNDLE = join(SERVER_FOLDER, 'main.server.mjs');

if (!existsSync(INDEX_HTML) || !existsSync(SERVER_BUNDLE)) {
  console.error('❌ Browser or server build missing. Build first!');
  process.exit(1);
}

const indexHtml = readFileSync(INDEX_HTML, 'utf-8');
const app = express();

app.use(express.static(BROWSER_FOLDER, { maxAge: '1y', index: false }));

app.get(/.*/, async (req, res) => {
  try {
    const moduleUrl = pathToFileURL(SERVER_BUNDLE).href;
    const { default: render } = await import(moduleUrl);

    if (typeof render !== 'function') {
      throw new Error('SSR render function not found in server bundle');
    }

    const html = await render({
      url: req.originalUrl,
      document: indexHtml,
    });

    res.setHeader('Content-Type', 'text/html');
    res.send(html);
  } catch (err) {
    console.error('SSR Error:', err);
    res.send(indexHtml);
  }
});

const port = process.env.PORT || 4000;
const host = process.env.HOST || '0.0.0.0';
app.listen(port, host, () => {
  console.log(`✅ Angular SSR running at http://${host}:${port}`);
});

